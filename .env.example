# ==============================================================================
# Cybersecurity OSINT Intelligence Platform Environment Configuration
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cyber_osint
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
# Local connection string used by host-side tests / development
DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/cyber_osint
# Internal docker-compose connection string
DOCKER_DATABASE_URL=postgresql://postgres:postgres_secure_pass@postgres:5432/cyber_osint

# Redis Configuration (Queues, Cache, Scheduler)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
DOCKER_REDIS_URL=redis://redis:6379/0

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Ingestion Pipeline Parameters
INGESTION_CONCURRENCY=5
DEFAULT_FETCH_TIMEOUT_SECONDS=30
MAX_CONTENT_PAYLOAD_SIZE_MB=10
DEFAULT_USER_AGENT=CyberOSINT-Intelligence-Bot/1.0 (+https://cyber-osint.local/bot)

# SSRF and Network Security Controls
SSRF_PROTECTION_ENABLED=true
ALLOW_PRIVATE_SUBNETS=false
MAX_REDIRECTS=3

# OpenSearch Configuration (Search & Analytics - Future Stage)
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_URL=http://localhost:9200
