# Cybersecurity OSINT Platform - Environment Variables Template
# Conforms to IMPLEMENT.md Section 36 (Step 35: Secret Management).
#
# CRITICAL SECURITY RULES:
# 1. Never commit real credentials, API keys, tokens, passwords, or private certificates to git.
# 2. Copy this template to .env for local runtime: cp .env.example .env
# 3. In production, use a dedicated secret manager (HashiCorp Vault, AWS Secrets Manager, or encrypted vault).

# -----------------------------------------------------------------------------
# 1. Mandatory Core Platform Secrets (IMPLEMENT.md Section 36)
# -----------------------------------------------------------------------------

# Relational Database Connection (PostgreSQL or SQLite dev fallback)
DATABASE_URL="postgresql://postgres:your_postgres_password_here@localhost:5432/cyber_osint"

# Redis Cache, Rate Limiting & Task Queues
REDIS_URL="redis://localhost:6379/0"

# OpenSearch Cluster Endpoint for Search & RRF Hybrid Retrieval
SEARCH_URL="http://localhost:9200"

# AI Intelligence Synthesis & Threat Assessment (OpenAI, Anthropic, or Local LLM)
AI_API_KEY="your-ai-api-key-here"

# Mistral AI Backend (Intelligence Summarization & Synthesis)
MISTRAL_API_KEY="your-mistral-api-key-here"
MISTRAL_MODEL="auto"  # 'auto' to dynamically auto-detect optimal available model, or specify e.g. mistral-small-latest

# Video & Multimedia Platform API Key (YouTube Data v3 / Conference Portals)
VIDEO_API_KEY="your-video-api-key-here"

# MinIO Object Storage (S3-compatible)
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="your_minio_password_here"
MINIO_PORT="9000"
MINIO_CONSOLE_PORT="9001"

# GitHub Personal Access Token (for GHSA advisories and PoC monitoring)
GITHUB_TOKEN="ghp_your_github_token_here"

# -----------------------------------------------------------------------------
# 2. Secret Manager Configuration (Production Backends)
# -----------------------------------------------------------------------------

# Selected Secret Backend: env (default), vault, aws, or encrypted_file
SECRET_BACKEND="env"

# HashiCorp Vault Settings (when SECRET_BACKEND="vault")
VAULT_ADDR="http://127.0.0.1:8200"
VAULT_TOKEN=""

# Encrypted Vault Master Key (when SECRET_BACKEND="encrypted_file")
SECRET_MASTER_KEY="your-32-byte-master-key-here"

# -----------------------------------------------------------------------------
# 3. Application Security & Runtime Controls
# -----------------------------------------------------------------------------
SECRET_KEY="your_secret_key_32_chars_minimum_here"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Database & Cache Details
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="cyber_osint"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password_here"
REDIS_HOST="localhost"
REDIS_PORT="6379"

# API & Security
API_HOST="0.0.0.0"
API_PORT="8000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
INGESTION_CONCURRENCY="4"
SSRF_PROTECTION_ENABLED="true"

